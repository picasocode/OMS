# JWT secret for session signing
JWT_SECRET="your-secret-key-here"

# Google OAuth login
# Add http://localhost:3000/api/auth/google/callback and your production callback URL
# as authorized redirect URIs in Google Cloud Console.
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Jotform backend
# Create five Jotform forms and add a long text field with question ID 7 to each form.
JOTFORM_API_KEY="your-jotform-api-key"
JOTFORM_ORDERS_FORM_ID="your-orders-form-id"
JOTFORM_PHYSICIANS_FORM_ID="your-physicians-form-id"
JOTFORM_SALES_REPS_FORM_ID="your-sales-reps-form-id"
JOTFORM_PRODUCTS_FORM_ID="your-products-form-id"
JOTFORM_DISCOUNTS_FORM_ID="your-discounts-form-id"
